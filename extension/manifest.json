{
  "manifest_version": 3,
  "name": "Prompt-Pinpoint",
  "version": "1.2.66",
  "description": "Select page elements and copy visible-page screenshots.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webNavigation",
    "clipboardWrite",
    "contextMenus"
  ],
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "screenshot-shortcut.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "i18n.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "🎯 Prompt-Pinpoint (click to start/stop)"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-selector": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Toggle element selector"
    }
  },
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
